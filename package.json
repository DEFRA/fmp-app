{
  "name": "fmfp",
  "version": "3.9.0",
  "description": "Flood map for planning",
  "main": "index.js",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "start": "node index.js",
    "copy": "sh ./bin/copy-assets",
    "build:jsAndCss": "webpack",
    "build": "npm run copy && npm run build:jsAndCss",
    "build-map-only": "sh ./bin/clean-map-build && webpack --config webpack.map-only.mjs",
    "eslint": "eslint",
    "test": "npm run eslint && jest --runInBand --collectCoverage",
    "test-timings": "jest --runInBand --collectCoverage --outputFile=test/results.json --json && node ./test/parseTestResults.js",
    "test-quick": "NOLOG=true jest --collectCoverage",
    "jest-watch": "NOLOG=true jest --watch",
    "jest-watch-coverage": "NOLOG=true jest --watchAll --coverage",
    "postinstall": "npm run build",
    "kill": "sudo kill -9 $(sudo lsof -t -i:3000)",
    "increment-version": "npm version prerelease --preid=pre -m \"Set Version to %s\"",
    "set-config": "run(){  cp ./config/server.$1.json ./config/server.json; }; run",
    "build:container": "docker build -t fmp-app .",
    "start:container": "docker --context desktop-linux run --platform linux/x86_64 --env-file=.env -p 3001:3001 fmp-app",
    "stop:container": "docker kill $(docker ps -q -f ancestor=fmp-app)"
  },
  "author": "defra",
  "license": "ISC",
  "dependencies": {
    "@arcgis/core": "^5.1.13",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@defra/fmp-map": "github:DEFRA/fmp-map#v3.9.0-pre12",
    "@defra/fmp-utilities": "github:DEFRA/fmp-utilities",
    "@esri/arcgis-rest-request": "^4.2.3",
    "@hapi/catbox-memory": "^6.0.2",
    "@hapi/crumb": "^9.0.1",
    "@hapi/h2o2": "^10.0.4",
    "@hapi/hapi": "^21.4.3",
    "@hapi/inert": "^7.1.1",
    "@hapi/vision": "^7.0.3",
    "@mapbox/polyline": "^1.2.1",
    "@turf/turf": "^7.2.0",
    "area-polygon": "^1.0.1",
    "axios": "^1.20.0",
    "babel-loader": "^10.0.0",
    "blipp": "^4.0.2",
    "css-loader": "^7.1.2",
    "dotenv": "^17.2.3",
    "govuk-frontend": "^5.11.0",
    "hapi-pino": "^13.0.0",
    "joi": "^18.3.2",
    "jszip": "^3.10.1",
    "magic-comments-loader": "^2.1.4",
    "mini-css-extract-plugin": "^2.9.2",
    "ngr-to-bng": "0.0.1",
    "nunjucks": "^3.2.4",
    "preact": "^10.28.3",
    "proj4": "2.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.3",
    "shpjs": "^6.2.0",
    "sql.js": "^1.14.1",
    "url-loader": "^4.1.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "devDependencies": {
    "@hapi/boom": "^10.0.1",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.0.1",
    "neostandard": "^0.12.2"
  }
}
