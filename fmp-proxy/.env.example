ENV=local
FMPPROXYPORT=8060

# AGOL credentials and service identity
agolClientId=replace-with-agol-client-id
agolClientSecret=replace-with-agol-client-secret
agolServiceId=replace-with-agol-service-id
ESRI_TOKEN_DURATION_MINUTES=7200

# Ordnance Survey values aligned with fmp-app config naming
httpTimeoutMs=3000
ordnanceSurveyOsGetCapabilitiesUrl=http://dummyuri
ordnanceSurveyOsMapsUrl=http://dummyuri
ordnanceSurveyOsNamesUrl=http://dummyuri
ordnanceSurveyOsSearchKey=replace_this
ordnanceSurveyOsClientId=replace_this
ordnanceSurveyOsClientSecret=replace_this

# Optional override if OS token endpoint changes
OS_TOKEN_URL=replace_this
